@model IEnumerable<FollowUp>
@{
    ViewData["Title"] = "Follow-Ups";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-calendar-check text-success me-2"></i>Follow-Up Management</h2>
        <p class="text-muted mb-0 small">Schedule, reschedule, and complete client engagements, calls, and meetings</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-success fw-medium shadow-sm"><i class="bi bi-plus-circle me-1"></i> Schedule Follow-Up</a>
    </div>
</div>

<!-- Overdue and Upcoming Warning Badges -->
<div class="row g-3 mb-4">
    @if (ViewBag.OverdueCount > 0)
    {
        <div class="col-12 col-md-6">
            <div class="alert alert-danger d-flex align-items-center mb-0 shadow-sm border-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>
                    <strong>Action Required:</strong> You have <strong>@ViewBag.OverdueCount</strong> overdue follow-up(s). Reschedule or complete them promptly.
                </div>
            </div>
        </div>
    }
    <div class="col-12 @(ViewBag.OverdueCount > 0 ? "col-md-6" : "col-md-12")">
        <div class="alert alert-info d-flex align-items-center mb-0 shadow-sm border-0" role="alert">
            <i class="bi bi-calendar2-week-fill fs-4 me-3 text-info"></i>
            <div>
                <strong>Upcoming Pipeline:</strong> <strong>@ViewBag.UpcomingCount</strong> follow-up activity scheduled for the next 7 days.
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-6 col-md-3">
                <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<FollowUpStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>

            <div class="col-6 col-md-3">
                <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<FollowUpType>()">
                    <option value="">All Types</option>
                </select>
            </div>

            @if (ViewBag.Users != null)
            {
                <div class="col-6 col-md-3">
                    <select name="assignedTo" class="form-select" asp-items="ViewBag.Users">
                        <option value="">All Executives</option>
                    </select>
                </div>
            }

            <div class="col-6 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary small">Showing @Model.Count() of @ViewBag.TotalCount records</span>
        <a asp-controller="Reports" asp-action="ExportFollowUpsCsv" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-arrow-down me-1"></i> Export CSV</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date & Time</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Associated Record</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                            No follow-ups found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var isOverdue = item.IsOverdue;
                        <tr class="@(isOverdue ? "table-danger-subtle" : "")">
                            <td>
                                <strong class="@(isOverdue ? "text-danger" : "text-dark")">@item.FollowUpDate.ToString("dd MMM yyyy, HH:mm")</strong>
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-1">Overdue</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@item.FollowUpType</span></td>
                            <td class="fw-semibold">@item.Subject</td>
                            <td class="small">
                                @if (item.Customer != null)
                                {
                                    <div><i class="bi bi-buildings text-primary me-1"></i><a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none">@item.Customer.CustomerName</a></div>
                                }
                                @if (item.Lead != null)
                                {
                                    <div><i class="bi bi-funnel text-info me-1"></i><a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="text-decoration-none">@item.Lead.LeadName</a></div>
                                }
                                @if (item.Opportunity != null)
                                {
                                    <div><i class="bi bi-briefcase text-warning me-1"></i><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@item.OpportunityId" class="text-decoration-none">@item.Opportunity.OpportunityName</a></div>
                                }
                            </td>
                            <td>
                                <span class="badge @(item.Status == FollowUpStatus.Completed ? "bg-success" : item.Status == FollowUpStatus.Cancelled ? "bg-secondary" : isOverdue ? "bg-danger" : "bg-warning text-dark")">
                                    @item.Status
                                </span>
                            </td>
                            <td class="small text-muted">@(item.AssignedUser?.FullName ?? item.AssignedUser?.UserName ?? "Unassigned")</td>
                            <td class="text-end">
                                @if (item.Status == FollowUpStatus.Planned)
                                {
                                    <button type="button" class="btn btn-sm btn-success me-1" data-bs-toggle="modal" data-bs-target="#completeModal-@item.FollowUpId" title="Mark Completed">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-warning text-dark me-1" data-bs-toggle="modal" data-bs-target="#rescheduleModal-@item.FollowUpId" title="Reschedule">
                                        <i class="bi bi-calendar-range"></i>
                                    </button>
                                }
                                <a asp-action="Edit" asp-route-id="@item.FollowUpId" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>

                                <!-- Complete Modal -->
                                <div class="modal fade text-start" id="completeModal-@item.FollowUpId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="Complete" asp-route-id="@item.FollowUpId" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold text-success"><i class="bi bi-check-circle me-2"></i>Complete Follow-Up</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="small text-muted mb-2">Subject: <strong>@item.Subject</strong></p>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-medium">Completion Remarks</label>
                                                        <textarea name="remarks" class="form-control" rows="3" placeholder="Summary of discussion, next steps agreed..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-success btn-sm px-3">Mark Completed</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Reschedule Modal -->
                                <div class="modal fade text-start" id="rescheduleModal-@item.FollowUpId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="Reschedule" asp-route-id="@item.FollowUpId" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold text-warning text-dark"><i class="bi bi-calendar-event me-2"></i>Reschedule Follow-Up</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="small text-muted mb-2">Subject: <strong>@item.Subject</strong></p>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-medium">New Follow-Up Date & Time <span class="text-danger">*</span></label>
                                                        <input type="datetime-local" name="newDate" class="form-control" value="@DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-ddTHH:mm")" min="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" required />
                                                        <small class="text-muted" style="font-size: 0.75rem;">Cannot be earlier than current date and time</small>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-medium">Reason for Rescheduling</label>
                                                        <input type="text" name="remarks" class="form-control" placeholder="e.g. Client requested deferral to next week" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-warning text-dark btn-sm px-3">Confirm Reschedule</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Page @ViewBag.Page of @ViewBag.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(ViewBag.Page == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.Page - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= ViewBag.TotalPages; p++)
                {
                    <li class="page-item @(p == ViewBag.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(ViewBag.Page == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.Page + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
