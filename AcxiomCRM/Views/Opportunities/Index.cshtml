@model IEnumerable<Opportunity>
@{
    ViewData["Title"] = "Opportunities";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-briefcase text-warning me-2"></i>Sales Opportunities</h2>
        <p class="text-muted mb-0 small">Track deals, stages, probabilities, and weighted sales forecast</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-warning text-dark fw-medium shadow-sm"><i class="bi bi-plus-circle me-1"></i> New Opportunity</a>
    </div>
</div>

<!-- Pipeline KPI Summary Strip -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-primary text-white">
            <span class="text-white-50 small text-uppercase fw-semibold">Open Pipeline</span>
            <h4 class="fw-bold mt-1 mb-0">₹@ViewBag.TotalPipeline.ToString("N2")</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-indigo text-white" style="background-color: #6366f1;">
            <span class="text-white-50 small text-uppercase fw-semibold">Weighted Pipeline</span>
            <h4 class="fw-bold mt-1 mb-0">₹@ViewBag.WeightedPipeline.ToString("N2")</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-success text-white">
            <span class="text-white-50 small text-uppercase fw-semibold">Won Deals</span>
            <h4 class="fw-bold mt-1 mb-0">@ViewBag.WonDeals</h4>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-secondary text-white">
            <span class="text-white-50 small text-uppercase fw-semibold">Open Count</span>
            <h4 class="fw-bold mt-1 mb-0">@ViewBag.OpenDeals Deals</h4>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search opportunity, customer..." value="@ViewBag.Search" />
                </div>
            </div>

            <div class="col-6 col-md-3">
                <select name="stage" class="form-select" asp-items="Html.GetEnumSelectList<OpportunityStage>()">
                    <option value="">All Stages</option>
                </select>
            </div>

            <div class="col-6 col-md-3">
                <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<OpportunityStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>

            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Opportunities Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary small">Showing @Model.Count() of @ViewBag.TotalCount records</span>
        <a asp-controller="Reports" asp-action="ExportOpportunitiesCsv" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-arrow-down me-1"></i> Export CSV</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Deal Name</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Stage</th>
                    <th>Probability</th>
                    <th>Weighted Value</th>
                    <th>Expected Close</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            No opportunities found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@item.OpportunityId" class="text-decoration-none text-dark">
                                    @item.OpportunityName
                                </a>
                            </td>
                            <td>@(item.Customer?.CustomerName ?? "-")</td>
                            <td class="fw-bold">₹@item.Amount.ToString("N2")</td>
                            <td><span class="badge bg-primary-subtle text-primary">@item.Stage</span></td>
                            <td>@item.Probability%</td>
                            <td class="text-muted small">₹@item.WeightedPipelineValue.ToString("N2")</td>
                            <td class="small">@item.ExpectedCloseDate.ToString("dd-MMM-yyyy")</td>
                            <td>
                                <span class="badge @(item.Status == OpportunityStatus.Won ? "bg-success" : item.Status == OpportunityStatus.Lost ? "bg-danger" : "bg-warning text-dark")">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.OpportunityId" class="btn btn-sm btn-outline-info me-1" title="View"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.OpportunityId" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Page @ViewBag.Page of @ViewBag.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(ViewBag.Page == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.Page - 1)">Previous</a>
                </li>
                @for (int p = 1; p <= ViewBag.TotalPages; p++)
                {
                    <li class="page-item @(p == ViewBag.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(ViewBag.Page == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.Page + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
