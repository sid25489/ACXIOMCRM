@model IEnumerable<FollowUp>
@{
    ViewData["Title"] = "Follow-Up Report";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
        <li class="breadcrumb-item active" aria-current="page">Follow-Up Report</li>
    </ol>
</nav>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-calendar-check text-success me-2"></i>Follow-Up & Touchpoint Report</h2>
        <p class="text-muted mb-0 small">Audit of client follow-ups, overdue statuses, types, and resolution times</p>
    </div>
    <div>
        <a asp-action="ExportFollowUpsCsv" asp-route-status="@ViewBag.Status" asp-route-type="@ViewBag.Type" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" class="btn btn-outline-success shadow-sm">
            <i class="bi bi-file-earmark-arrow-down me-1"></i> Export to CSV
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-6 col-md-3">
                <select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<FollowUpStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="type" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<FollowUpType>()">
                    <option value="">All Types</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-6 col-md-2">
                <input type="date" name="toDate" class="form-control form-control-sm" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-funnel"></i></button>
                <a asp-action="FollowUps" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Customer</th>
                    <th>Lead</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Completed On</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.FollowUpDate.ToString("dd MMM yyyy, HH:mm")</td>
                        <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                        <td class="fw-semibold">@f.Subject</td>
                        <td>@(f.Customer?.CustomerName ?? "-")</td>
                        <td>@(f.Lead?.LeadName ?? "-")</td>
                        <td>
                            <span class="badge @(f.Status == FollowUpStatus.Completed ? "bg-success" : f.IsOverdue ? "bg-danger" : "bg-warning text-dark")">
                                @f.Status
                            </span>
                        </td>
                        <td>@(f.AssignedUser?.FullName ?? f.AssignedUser?.UserName ?? "Unassigned")</td>
                        <td>@(f.CompletedDate?.ToString("dd MMM yyyy") ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
