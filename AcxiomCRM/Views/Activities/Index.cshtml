@model IEnumerable<Activity>
@{
    ViewData["Title"] = "Activities";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-clock-history text-secondary me-2"></i>Activity History</h2>
        <p class="text-muted mb-0 small">Audit log of customer and lead calls, meetings, notes, and task completions</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-circle me-1"></i> Log Activity</a>
    </div>
</div>

<!-- Activity Filter Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-6 col-md-3">
                <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<ActivityType>()">
                    <option value="">All Activity Types</option>
                </select>
            </div>

            <div class="col-6 col-md-3">
                <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<ActivityStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>

            <div class="col-6 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Related To</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">No activities found.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="small">@item.ActivityDate.ToString("dd MMM yyyy, HH:mm")</td>
                            <td><span class="badge bg-light text-dark border">@item.ActivityType</span></td>
                            <td class="fw-semibold">@item.Subject</td>
                            <td class="small">
                                @if (item.Customer != null)
                                {
                                    <div><i class="bi bi-buildings text-primary me-1"></i><a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none">@item.Customer.CustomerName</a></div>
                                }
                                @if (item.Lead != null)
                                {
                                    <div><i class="bi bi-funnel text-info me-1"></i><a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="text-decoration-none">@item.Lead.LeadName</a></div>
                                }
                                @if (item.Opportunity != null)
                                {
                                    <div><i class="bi bi-briefcase text-warning me-1"></i><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@item.OpportunityId" class="text-decoration-none">@item.Opportunity.OpportunityName</a></div>
                                }
                            </td>
                            <td><span class="badge bg-success-subtle text-success">@item.Status</span></td>
                            <td class="small text-muted">@(item.AssignedUser?.FullName ?? item.AssignedUser?.UserName ?? "Unassigned")</td>
                            <td class="small text-muted text-truncate" style="max-width: 250px;">@(item.Description ?? "-")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
