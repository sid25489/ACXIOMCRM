@model DashboardViewModel
@{
    ViewData["Title"] = "Executive Dashboard";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard & Analytics</h2>
        <p class="text-muted mb-0 small">Real-time pipeline, lead activity, and performance indicators</p>
    </div>

    <!-- Date Range Filter Buttons -->
    <div class="btn-group shadow-sm" role="group">
        <a asp-action="Index" asp-route-dateFilter="all" class="btn btn-sm @(Model.DateFilter == "all" ? "btn-primary" : "btn-outline-secondary")">All Time</a>
        <a asp-action="Index" asp-route-dateFilter="today" class="btn btn-sm @(Model.DateFilter == "today" ? "btn-primary" : "btn-outline-secondary")">Today</a>
        <a asp-action="Index" asp-route-dateFilter="thisweek" class="btn btn-sm @(Model.DateFilter == "thisweek" ? "btn-primary" : "btn-outline-secondary")">This Week</a>
        <a asp-action="Index" asp-route-dateFilter="thismonth" class="btn btn-sm @(Model.DateFilter == "thismonth" ? "btn-primary" : "btn-outline-secondary")">This Month</a>
    </div>
</div>

<!-- 10 Mandatory KPI Cards Grid -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card kpi-card h-100 border-0 shadow-sm p-3 border-start border-4 border-primary">
            <span class="text-muted small fw-medium text-uppercase">Customers</span>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <h3 class="fw-bold mb-0 text-dark">@Model.Kpis.TotalCustomers</h3>
                <div class="badge bg-primary-subtle text-primary p-2 rounded-3"><i class="bi bi-buildings fs-5"></i></div>
            </div>
            <a asp-controller="Customers" asp-action="Index" class="text-primary small text-decoration-none mt-2">View customers &rarr;</a>
        </div>
    </div>

    <!-- Total Leads -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card kpi-card h-100 border-0 shadow-sm p-3 border-start border-4 border-info">
            <span class="text-muted small fw-medium text-uppercase">Total Leads</span>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <h3 class="fw-bold mb-0 text-dark">@Model.Kpis.TotalLeads</h3>
                <div class="badge bg-info-subtle text-info p-2 rounded-3"><i class="bi bi-funnel fs-5"></i></div>
            </div>
            <span class="text-muted small mt-2">Captured prospects</span>
        </div>
    </div>

    <!-- Open Leads -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card kpi-card h-100 border-0 shadow-sm p-3 border-start border-4 border-cyan">
            <span class="text-muted small fw-medium text-uppercase">Open Leads</span>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <h3 class="fw-bold mb-0 text-dark">@Model.Kpis.OpenLeads</h3>
                <div class="badge bg-secondary-subtle text-dark p-2 rounded-3"><i class="bi bi-person-lines-fill fs-5"></i></div>
            </div>
            <a asp-controller="Leads" asp-action="Index" class="text-info small text-decoration-none mt-2">Active pipeline &rarr;</a>
        </div>
    </div>

    <!-- Total Opportunities -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card kpi-card h-100 border-0 shadow-sm p-3 border-start border-4 border-indigo">
            <span class="text-muted small fw-medium text-uppercase">Opportunities</span>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <h3 class="fw-bold mb-0 text-dark">@Model.Kpis.TotalOpportunities</h3>
                <div class="badge bg-primary-subtle text-indigo p-2 rounded-3"><i class="bi bi-briefcase fs-5"></i></div>
            </div>
            <span class="text-muted small mt-2">All deals tracked</span>
        </div>
    </div>

    <!-- Open Deals -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card kpi-card h-100 border-0 shadow-sm p-3 border-start border-4 border-warning">
            <span class="text-muted small fw-medium text-uppercase">Open Deals</span>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <h3 class="fw-bold mb-0 text-dark">@Model.Kpis.OpenOpportunities</h3>
                <div class="badge bg-warning-subtle text-warning p-2 rounded-3"><i class="bi bi-hourglass-split fs-5"></i></div>
            </div>
            <span class="text-muted small mt-2">In negotiation</span>
        </div>
    </div>

    <!-- Won Opportunities -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card kpi-card h-100 border-0 shadow-sm p-3 border-start border-4 border-success">
            <span class="text-muted small fw-medium text-uppercase">Won Deals</span>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <h3 class="fw-bold mb-0 text-success">@Model.Kpis.WonOpportunities</h3>
                <div class="badge bg-success-subtle text-success p-2 rounded-3"><i class="bi bi-trophy fs-5"></i></div>
            </div>
            <span class="text-success small mt-2">Closed revenue</span>
        </div>
    </div>

    <!-- Lost Opportunities -->
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card kpi-card h-100 border-0 shadow-sm p-3 border-start border-4 border-danger">
            <span class="text-muted small fw-medium text-uppercase">Lost Deals</span>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <h3 class="fw-bold mb-0 text-danger">@Model.Kpis.LostOpportunities</h3>
                <div class="badge bg-danger-subtle text-danger p-2 rounded-3"><i class="bi bi-x-circle fs-5"></i></div>
            </div>
            <span class="text-muted small mt-2">Lost outcomes</span>
        </div>
    </div>

    <!-- Total Open Pipeline Value -->
    <div class="col-12 col-md-4 col-xl-4">
        <div class="card kpi-card h-100 border-0 shadow-sm p-3 border-start border-4 border-primary bg-primary text-white">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-white-50 small fw-medium text-uppercase">Total Pipeline Value</span>
                    <h2 class="fw-bold mt-1 mb-0">₹@Model.Kpis.TotalOpenPipelineValue.ToString("N2")</h2>
                    <small class="text-white-50">Weighted: ₹@Model.Kpis.WeightedOpenPipelineValue.ToString("N2")</small>
                </div>
                <div class="badge bg-white text-primary p-3 rounded-circle"><i class="bi bi-currency-rupee fs-4"></i></div>
            </div>
        </div>
    </div>

    <!-- Upcoming Follow-Ups -->
    <div class="col-6 col-md-4 col-xl-3">
        <div class="card kpi-card h-100 border-0 shadow-sm p-3 border-start border-4 border-info">
            <span class="text-muted small fw-medium text-uppercase">Upcoming Follow-Ups</span>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <h3 class="fw-bold mb-0 text-dark">@Model.Kpis.UpcomingFollowUps</h3>
                <div class="badge bg-info-subtle text-info p-2 rounded-3"><i class="bi bi-calendar-event fs-5"></i></div>
            </div>
            <a asp-controller="FollowUps" asp-action="Index" class="text-info small text-decoration-none mt-2">Next 7 days &rarr;</a>
        </div>
    </div>

    <!-- Overdue Follow-Ups -->
    <div class="col-6 col-md-4 col-xl-3">
        <div class="card kpi-card h-100 border-0 shadow-sm p-3 border-start border-4 @(Model.Kpis.OverdueFollowUps > 0 ? "border-danger bg-danger-subtle" : "border-secondary")">
            <span class="text-muted small fw-medium text-uppercase">Overdue Follow-Ups</span>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <h3 class="fw-bold mb-0 @(Model.Kpis.OverdueFollowUps > 0 ? "text-danger" : "text-dark")">@Model.Kpis.OverdueFollowUps</h3>
                <div class="badge @(Model.Kpis.OverdueFollowUps > 0 ? "bg-danger text-white" : "bg-light text-muted") p-2 rounded-3"><i class="bi bi-alarm fs-5"></i></div>
            </div>
            <a asp-controller="FollowUps" asp-action="Index" class="text-danger small text-decoration-none mt-2">Needs action &rarr;</a>
        </div>
    </div>
</div>

<!-- 3 Mandatory Chart.js Visualizations -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Lead Status Distribution -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart text-primary me-2"></i>Lead Status Distribution</h6>
            </div>
            <div class="card-body d-flex flex-column justify-content-center p-3">
                <div style="height: 260px; position: relative;">
                    <canvas id="leadStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Opportunity Pipeline by Stage -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-steps text-info me-2"></i>Pipeline by Stage</h6>
            </div>
            <div class="card-body d-flex flex-column justify-content-center p-3">
                <div style="height: 260px; position: relative;">
                    <canvas id="pipelineStageChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 3: Monthly Sales (Past 6 Months) -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up text-success me-2"></i>Monthly Won Sales</h6>
            </div>
            <div class="card-body d-flex flex-column justify-content-center p-3">
                <div style="height: 260px; position: relative;">
                    <canvas id="monthlySalesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Action Shortcuts -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <h6 class="fw-bold mb-3 text-secondary text-uppercase small">Quick Operations</h6>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Customers" asp-action="Create" class="btn btn-outline-primary fw-medium"><i class="bi bi-plus-circle me-1"></i> New Customer</a>
            <a asp-controller="Leads" asp-action="Create" class="btn btn-outline-info text-dark fw-medium"><i class="bi bi-funnel me-1"></i> Capture Lead</a>
            <a asp-controller="Opportunities" asp-action="Create" class="btn btn-outline-warning text-dark fw-medium"><i class="bi bi-briefcase me-1"></i> New Opportunity</a>
            <a asp-controller="FollowUps" asp-action="Create" class="btn btn-outline-success fw-medium"><i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up</a>
            <a asp-controller="Activities" asp-action="Create" class="btn btn-outline-secondary fw-medium"><i class="bi bi-clock-history me-1"></i> Log Activity</a>
            <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-dark fw-medium"><i class="bi bi-file-earmark-spreadsheet me-1"></i> View Reports</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Chart 1: Lead Status
            const leadCtx = document.getElementById('leadStatusChart').getContext('2d');
            const leadData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Charts.LeadStatusDistribution));
            new Chart(leadCtx, {
                type: 'doughnut',
                data: {
                    labels: leadData.Labels,
                    datasets: [{
                        data: leadData.Values,
                        backgroundColor: leadData.BackgroundColors,
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                    }
                }
            });

            // Chart 2: Pipeline by Stage
            const pipelineCtx = document.getElementById('pipelineStageChart').getContext('2d');
            const pipelineData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Charts.PipelineByStage));
            new Chart(pipelineCtx, {
                type: 'bar',
                data: {
                    labels: pipelineData.Labels,
                    datasets: [{
                        label: 'Deal Amount (₹)',
                        data: pipelineData.Values,
                        backgroundColor: pipelineData.BackgroundColors,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return '₹' + value.toLocaleString(); }
                            }
                        }
                    }
                }
            });

            // Chart 3: Monthly Sales
            const salesCtx = document.getElementById('monthlySalesChart').getContext('2d');
            const salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Charts.MonthlySales));
            new Chart(salesCtx, {
                type: 'line',
                data: {
                    labels: salesData.Labels,
                    datasets: [{
                        label: 'Won Revenue (₹)',
                        data: salesData.Values,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointBackgroundColor: '#10b981',
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return '₹' + value.toLocaleString(); }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
