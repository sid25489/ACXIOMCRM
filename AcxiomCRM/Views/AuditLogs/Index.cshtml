@model IEnumerable<AuditLog>
@{
    ViewData["Title"] = "Security & Business Audit Logs";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-journal-text text-danger me-2"></i>Audit Logs & Security Trail</h2>
        <p class="text-muted mb-0 small">Immutable transactional audit trail capturing logins, record creation, updates, and role changes</p>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-6 col-md-2">
                <input type="text" name="module" class="form-control form-control-sm" placeholder="Module (e.g. Customer, Lead)" value="@ViewBag.Module" />
            </div>

            <div class="col-6 col-md-2">
                <input type="text" name="action" class="form-control form-control-sm" placeholder="Action (e.g. Create, Update)" value="@ViewBag.Action" />
            </div>

            @if (ViewBag.Users != null)
            {
                <div class="col-6 col-md-3">
                    <select name="userId" class="form-select form-select-sm" asp-items="ViewBag.Users">
                        <option value="">All Users</option>
                    </select>
                </div>
            }

            <div class="col-6 col-md-2">
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" placeholder="From Date" />
            </div>

            <div class="col-6 col-md-2">
                <input type="date" name="toDate" class="form-control form-control-sm" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" placeholder="To Date" />
            </div>

            <div class="col-12 col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-funnel"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Audit Log Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 font-monospace small">
            <thead class="font-sans-serif">
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Record ID</th>
                    <th>Result</th>
                    <th>IP Address</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">No audit log records found matching the criteria.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@(item.User?.FullName ?? item.User?.UserName ?? "System / Anonymous")</td>
                            <td>
                                <span class="badge @(item.Action == "Delete" || item.Action == "FailedLogin" ? "bg-danger" : item.Action == "Create" || item.Action == "Login" ? "bg-success" : "bg-primary-subtle text-primary")">
                                    @item.Action
                                </span>
                            </td>
                            <td>@item.EntityName</td>
                            <td>@(item.RecordId ?? "-")</td>
                            <td>
                                <span class="badge @(item.Result == "Success" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                    @item.Result
                                </span>
                            </td>
                            <td>@(item.IpAddress ?? "127.0.0.1")</td>
                            <td>
                                <span class="text-truncate d-inline-block" style="max-width: 300px;" title="@item.Details">
                                    @(item.Details ?? item.NewValue ?? "-")
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
