@model IEnumerable<Customer>
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-buildings text-primary me-2"></i>Customers</h2>
        <p class="text-muted mb-0 small">Manage client accounts, contact details, and assigned relationships</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-circle me-1"></i> Add Customer</a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search by name, code, email, phone..." value="@ViewBag.Search" />
                </div>
            </div>

            <div class="col-6 col-md-3">
                <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<CustomerStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>

            @if (ViewBag.Owners != null)
            {
                <div class="col-6 col-md-3">
                    <select name="ownerId" class="form-select" asp-items="ViewBag.Owners">
                        <option value="">All Owners</option>
                    </select>
                </div>
            }

            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary small">Showing @Model.Count() of @ViewBag.TotalCount records</span>
        <a asp-controller="Reports" asp-action="ExportCustomersCsv" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-arrow-down me-1"></i> Export CSV</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Company</th>
                    <th>Status</th>
                    <th>Owner</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            No customers found matching the criteria.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@item.CustomerCode</span></td>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none text-dark">
                                    @item.CustomerName
                                </a>
                            </td>
                            <td><a href="mailto:@item.Email" class="text-muted text-decoration-none small">@item.Email</a></td>
                            <td class="small">@item.Phone</td>
                            <td class="small text-muted">@(item.CompanyName ?? "-")</td>
                            <td>
                                <span class="badge @(item.Status == CustomerStatus.Active ? "bg-success-subtle text-success" : item.Status == CustomerStatus.Inactive ? "bg-secondary-subtle text-secondary" : "bg-info-subtle text-info")">
                                    @item.Status
                                </span>
                            </td>
                            <td class="small text-muted">@(item.Owner?.FullName ?? item.Owner?.UserName ?? "Unassigned")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-info me-1" title="View Details"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-primary me-1" title="Edit"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.CustomerId" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade text-start" id="deleteModal-@item.CustomerId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Deletion</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete customer <strong>@item.CustomerName</strong> (@item.CustomerCode)?
                                                <p class="text-muted small mt-2 mb-0">If this customer has historical deals or activities, it will be safely deactivated instead of completely removed.</p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" asp-route-id="@item.CustomerId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Page @ViewBag.Page of @ViewBag.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(ViewBag.Page == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.Page - 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-ownerId="@ViewBag.OwnerId">Previous</a>
                </li>
                @for (int p = 1; p <= ViewBag.TotalPages; p++)
                {
                    <li class="page-item @(p == ViewBag.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-ownerId="@ViewBag.OwnerId">@p</a>
                    </li>
                }
                <li class="page-item @(ViewBag.Page == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.Page + 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-ownerId="@ViewBag.OwnerId">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
