@{
    ViewData["Title"] = "Access Denied";
}

<div class="card shadow-sm border-0 text-center p-5" style="max-width: 500px;">
    <div class="mb-4">
        <i class="bi bi-shield-x text-danger display-1"></i>
    </div>
    <h3 class="fw-bold text-dark mb-2">Access Denied</h3>
    <p class="text-muted mb-4">
        You do not have permission to access the requested CRM record or administrative feature.
        This operation has been logged for security auditing.
    </p>
    <div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4 fw-medium">
            <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
        </a>
    </div>
</div>
