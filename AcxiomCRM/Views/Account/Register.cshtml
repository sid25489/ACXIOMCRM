@model RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="card shadow-lg border-0 rounded-4" style="max-width: 480px; width: 100%;">
    <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="badge bg-primary p-3 rounded-circle mb-3">
                <i class="bi bi-person-plus-fill fs-3 text-white"></i>
            </div>
            <h3 class="fw-bold text-dark">Join Acxiom<span class="text-primary">CRM</span></h3>
            <p class="text-muted small">Register a new enterprise user account</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post" id="registerForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-medium small">Full Name <span class="text-danger">*</span></label>
                <input asp-for="FullName" class="form-control" placeholder="John Doe" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-medium small">Email Address <span class="text-danger">*</span></label>
                <input asp-for="Email" class="form-control" placeholder="name@company.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Department" class="form-label fw-medium small">Department</label>
                <input asp-for="Department" class="form-control" placeholder="e.g. Sales, Marketing" />
                <span asp-validation-for="Department" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-medium small">Password <span class="text-danger">*</span></label>
                <input asp-for="Password" class="form-control" placeholder="At least 8 chars with uppercase, number & symbol" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-medium small">Confirm Password <span class="text-danger">*</span></label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat your password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm" id="btnRegister">
                <i class="bi bi-check2-circle me-2"></i>Create Account
            </button>
        </form>

        <div class="mt-4 pt-3 border-top text-center text-muted small">
            <span>Already have an account? </span>
            <a asp-controller="Account" asp-action="Login" class="text-primary fw-medium text-decoration-none">Sign In</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
