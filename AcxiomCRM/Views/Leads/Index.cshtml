@model IEnumerable<Lead>
@{
    ViewData["Title"] = "Leads";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-funnel text-info me-2"></i>Leads Pipeline</h2>
        <p class="text-muted mb-0 small">Capture, qualify, assign, and convert prospects into loyal customers</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-info text-dark fw-medium shadow-sm"><i class="bi bi-plus-circle me-1"></i> Capture Lead</a>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search leads, email, company..." value="@ViewBag.Search" />
                </div>
            </div>

            <div class="col-6 col-md-2">
                <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<LeadStatus>()">
                    <option value="">All Statuses</option>
                </select>
            </div>

            <div class="col-6 col-md-2">
                <select name="source" class="form-select" asp-items="Html.GetEnumSelectList<LeadSource>()">
                    <option value="">All Sources</option>
                </select>
            </div>

            @if (ViewBag.Users != null)
            {
                <div class="col-6 col-md-3">
                    <select name="assignedTo" class="form-select" asp-items="ViewBag.Users">
                        <option value="">All Assigned Users</option>
                    </select>
                </div>
            }

            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Leads Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary small">Showing @Model.Count() of @ViewBag.TotalCount records</span>
        <a asp-controller="Reports" asp-action="ExportLeadsCsv" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-arrow-down me-1"></i> Export CSV</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Lead Name</th>
                    <th>Company</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Expected Value</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            No leads found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@item.LeadCode</span></td>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@item.LeadId" class="text-decoration-none text-dark">
                                    @item.LeadName
                                </a>
                            </td>
                            <td class="small text-muted">@(item.CompanyName ?? "-")</td>
                            <td><span class="badge bg-light text-secondary border">@item.Source</span></td>
                            <td>
                                <span class="badge @(item.Status == LeadStatus.New ? "bg-primary-subtle text-primary" :
                                                     item.Status == LeadStatus.Qualified ? "bg-success-subtle text-success" :
                                                     item.Status == LeadStatus.Converted ? "bg-purple-subtle text-purple" :
                                                     item.Status == LeadStatus.Lost ? "bg-danger-subtle text-danger" : "bg-warning-subtle text-warning")">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                <span class="badge @(item.Priority == LeadPriority.Urgent ? "bg-danger" : item.Priority == LeadPriority.High ? "bg-warning text-dark" : "bg-light text-dark border")">
                                    @item.Priority
                                </span>
                            </td>
                            <td class="fw-bold">₹@item.ExpectedValue.ToString("N2")</td>
                            <td class="small text-muted">@(item.AssignedUser?.FullName ?? item.AssignedUser?.UserName ?? "Unassigned")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.LeadId" class="btn btn-sm btn-outline-info me-1" title="View"><i class="bi bi-eye"></i></a>
                                @if (item.Status != LeadStatus.Converted)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.LeadId" class="btn btn-sm btn-outline-primary me-1" title="Edit"><i class="bi bi-pencil"></i></a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
            <span class="small text-muted">Page @ViewBag.Page of @ViewBag.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(ViewBag.Page == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.Page - 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-source="@ViewBag.Source" asp-route-assignedTo="@ViewBag.AssignedTo">Previous</a>
                </li>
                @for (int p = 1; p <= ViewBag.TotalPages; p++)
                {
                    <li class="page-item @(p == ViewBag.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-source="@ViewBag.Source" asp-route-assignedTo="@ViewBag.AssignedTo">@p</a>
                    </li>
                }
                <li class="page-item @(ViewBag.Page == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.Page + 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-source="@ViewBag.Source" asp-route-assignedTo="@ViewBag.AssignedTo">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
