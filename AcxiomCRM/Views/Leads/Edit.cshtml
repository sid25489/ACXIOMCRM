@model Lead
@{
    ViewData["Title"] = $"Edit Lead: {Model.LeadName}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Leads</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.LeadId">@Model.LeadCode</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-pencil-square text-info me-2"></i>Edit Lead: @Model.LeadName</h5>
                <span class="badge bg-light text-dark border">@Model.LeadCode</span>
            </div>

            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.LeadId" method="post" id="leadEditForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="LeadName" class="form-label fw-medium small">Lead / Contact Name <span class="text-danger">*</span></label>
                            <input asp-for="LeadName" class="form-control" maxlength="150" required />
                            <span asp-validation-for="LeadName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-medium small">Company Name</label>
                            <input asp-for="CompanyName" class="form-control" maxlength="150" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-medium small">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control" maxlength="150" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-medium small">Mobile Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control" pattern="^[6-9]\d{9}$" maxlength="20" title="10-digit Indian mobile number." />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label asp-for="Source" class="form-label fw-medium small">Source</label>
                            <select asp-for="Source" class="form-select" asp-items="Html.GetEnumSelectList<LeadSource>()"></select>
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Status" class="form-label fw-medium small">Status</label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<LeadStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Priority" class="form-label fw-medium small">Priority</label>
                            <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<LeadPriority>()"></select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="ExpectedValue" class="form-label fw-medium small">Expected Value (₹)</label>
                            <input asp-for="ExpectedValue" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                        </div>
                    </div>

                    @if (ViewBag.Users != null)
                    {
                        <div class="mb-3">
                            <label asp-for="AssignedTo" class="form-label fw-medium small">Reassign Executive</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.Users"></select>
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-medium small">Notes & Requirements</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" maxlength="2000"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-save me-1"></i> Update Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
