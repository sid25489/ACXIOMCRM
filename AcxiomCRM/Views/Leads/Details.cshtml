@model Lead
@{
    ViewData["Title"] = $"Lead: {Model.LeadName}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Leads</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.LeadCode</li>
    </ol>
</nav>

<!-- Header Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-light text-dark border">@Model.LeadCode</span>
                    <span class="badge @(Model.Status == LeadStatus.Qualified ? "bg-success" : Model.Status == LeadStatus.Converted ? "bg-purple bg-primary" : Model.Status == LeadStatus.Lost ? "bg-danger" : "bg-info text-dark")">@Model.Status</span>
                    <span class="badge bg-secondary-subtle text-dark">Priority: @Model.Priority</span>
                </div>
                <h2 class="fw-bold text-dark mb-1">@Model.LeadName</h2>
                <p class="text-muted mb-0"><i class="bi bi-building me-1"></i>@(Model.CompanyName ?? "Prospect Organization")</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                @if (Model.Status != LeadStatus.Converted)
                {
                    <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i> Edit</a>
                }

                @if (Model.Status == LeadStatus.Qualified)
                {
                    <button type="button" class="btn btn-success fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#convertLeadModal">
                        <i class="bi bi-person-check-fill me-1"></i> Convert to Customer
                    </button>
                }

                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-success"><i class="bi bi-calendar-plus me-1"></i> Follow-Up</a>
                <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-secondary"><i class="bi bi-clock-history me-1"></i> Log Activity</a>
            </div>
        </div>

        <!-- Workflow Status Transitions -->
        @if (Model.Status != LeadStatus.Converted)
        {
            <div class="mt-4 p-3 bg-light rounded-3 d-flex flex-wrap align-items-center gap-2">
                <span class="small fw-semibold text-secondary me-2"><i class="bi bi-arrow-right-circle me-1"></i>Move Workflow Status:</span>
                @if (Model.Status == LeadStatus.New)
                {
                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="leadId" value="@Model.LeadId" />
                        <input type="hidden" name="newStatus" value="@LeadStatus.Contacted" />
                        <button type="submit" class="btn btn-sm btn-outline-info">Mark as Contacted</button>
                    </form>
                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="leadId" value="@Model.LeadId" />
                        <input type="hidden" name="newStatus" value="@LeadStatus.Lost" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Mark as Lost</button>
                    </form>
                }
                else if (Model.Status == LeadStatus.Contacted)
                {
                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="leadId" value="@Model.LeadId" />
                        <input type="hidden" name="newStatus" value="@LeadStatus.Qualified" />
                        <button type="submit" class="btn btn-sm btn-success">Qualify Lead</button>
                    </form>
                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="leadId" value="@Model.LeadId" />
                        <input type="hidden" name="newStatus" value="@LeadStatus.Unqualified" />
                        <button type="submit" class="btn btn-sm btn-outline-warning text-dark">Mark as Unqualified</button>
                    </form>
                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="leadId" value="@Model.LeadId" />
                        <input type="hidden" name="newStatus" value="@LeadStatus.Lost" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Mark as Lost</button>
                    </form>
                }
                else if (Model.Status == LeadStatus.Qualified)
                {
                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="leadId" value="@Model.LeadId" />
                        <input type="hidden" name="newStatus" value="@LeadStatus.Lost" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Mark as Lost</button>
                    </form>
                }
            </div>
        }

        <hr class="my-4" />

        <div class="row g-4 text-secondary small">
            <div class="col-6 col-md-3">
                <span class="d-block text-muted text-uppercase" style="font-size: 0.75rem;">Email Address</span>
                <strong class="text-dark fs-6"><a href="mailto:@Model.Email" class="text-decoration-none">@(Model.Email ?? "-")</a></strong>
            </div>
            <div class="col-6 col-md-3">
                <span class="d-block text-muted text-uppercase" style="font-size: 0.75rem;">Phone Number</span>
                <strong class="text-dark fs-6">@(Model.Phone ?? "-")</strong>
            </div>
            <div class="col-6 col-md-3">
                <span class="d-block text-muted text-uppercase" style="font-size: 0.75rem;">Expected Pipeline Value</span>
                <strong class="text-success fs-5">₹@Model.ExpectedValue.ToString("N2")</strong>
            </div>
            <div class="col-6 col-md-3">
                <span class="d-block text-muted text-uppercase" style="font-size: 0.75rem;">Lead Source</span>
                <strong class="text-dark fs-6">@Model.Source</strong>
            </div>
            <div class="col-6 col-md-3">
                <span class="d-block text-muted text-uppercase" style="font-size: 0.75rem;">Assigned Executive</span>
                <strong class="text-dark fs-6">@(Model.AssignedUser?.FullName ?? Model.AssignedUser?.UserName ?? "Unassigned")</strong>
            </div>
            <div class="col-6 col-md-3">
                <span class="d-block text-muted text-uppercase" style="font-size: 0.75rem;">Conversion Status</span>
                @if (Model.CustomerId.HasValue && Model.Customer != null)
                {
                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-bold text-primary text-decoration-none">
                        Converted to @Model.Customer.CustomerName (@Model.Customer.CustomerCode)
                    </a>
                }
                else
                {
                    <span class="text-muted">Not Converted</span>
                }
            </div>
            <div class="col-12 col-md-6">
                <span class="d-block text-muted text-uppercase" style="font-size: 0.75rem;">Timestamps</span>
                <span class="text-muted">Created: @Model.CreatedDate.ToString("dd MMM yyyy, HH:mm") by @Model.CreatedBy | Modified: @(Model.ModifiedDate?.ToString("dd MMM yyyy, HH:mm") ?? "-")</span>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="mt-4 p-3 bg-light rounded-3">
                <span class="fw-semibold text-secondary d-block mb-1 small"><i class="bi bi-sticky me-1"></i>Requirements & Notes:</span>
                <p class="mb-0 text-dark small">@Model.Notes</p>
            </div>
        }
    </div>
</div>

<!-- Convert Lead Modal -->
@if (Model.Status == LeadStatus.Qualified)
{
    <div class="modal fade" id="convertLeadModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Convert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="LeadId" value="@Model.LeadId" />

                    <div class="modal-header">
                        <h5 class="modal-title fw-bold text-success"><i class="bi bi-check2-circle me-2"></i>Convert Qualified Lead</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <p class="small text-muted mb-3">
                            Converting this lead will automatically link or create a Customer Master record and transition the lead status to <strong>Converted</strong>.
                        </p>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" name="CreateOpportunity" value="true" id="chkCreateOpp" checked>
                            <label class="form-check-label fw-medium small" for="chkCreateOpp">Simultaneously Create Sales Opportunity</label>
                        </div>

                        <div id="oppFields">
                            <div class="mb-3">
                                <label class="form-label small fw-medium">Opportunity Name</label>
                                <input type="text" name="OpportunityName" class="form-control form-control-sm" value="@Model.LeadName - Deal" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-medium">Deal Amount (₹)</label>
                                <input type="number" step="0.01" name="OpportunityAmount" class="form-control form-control-sm" value="@Model.ExpectedValue" min="0.01" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-medium">Expected Close Date</label>
                                <input type="date" name="ExpectedCloseDate" class="form-control form-control-sm" value="@DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-dd")" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success btn-sm px-3 fw-medium">Confirm & Convert</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
